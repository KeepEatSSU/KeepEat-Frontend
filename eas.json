{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "demo",
      "environment": "preview",
      "env": {
        "APP_ENV": "demo"
      }
    },
    "demo": {
      "distribution": "internal",
      "channel": "demo",
      "environment": "preview",
      "env": {
        "APP_ENV": "demo"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_ENV": "prod"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
